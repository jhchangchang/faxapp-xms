+// 목록 조회 - X-Total-Count 헤더까지 함께 반환 (페이지네이션용)
+async function apiPaged(path,opts={}){
+  const r=await fetch(API+path,{credentials:'include',headers:opts.body&&!(opts.body instanceof FormData)?{'Content-Type':'application/json'}:{},...opts});
+  if(!r.ok){const e=await r.json().catch(()=>({detail:r.statusText}));throw new Error(e.detail||'요청을 처리하지 못했습니다');}
+  const items=r.status===204?[]:await r.json();
+  const total=parseInt(r.headers.get('X-Total-Count'),10);
+  return {items, total:Number.isFinite(total)?total:items.length};
+}
+// 페이지네이션 컨트롤 (이전/다음 + 현재 범위 표시)
+function Pager({total,limit,offset,setOffset}){
+  if(total<=limit && offset===0) return null;
+  const from=total===0?0:offset+1, to=Math.min(offset+limit,total);
+  const page=Math.floor(offset/limit)+1, pages=Math.max(1,Math.ceil(total/limit));
+  return <div className="btn-row" style={{justifyContent:'space-between',alignItems:'center',padding:'10px 2px'}}>
+    <span className="dim" style={{fontSize:12.5}}>{total}건 중 {from}-{to} · {page}/{pages}페이지</span>
+    <div className="btn-row">
+      <button className="btn btn-s" disabled={offset===0} onClick={()=>setOffset(Math.max(0,offset-limit))}>이전</button>
+      <button className="btn btn-s" disabled={offset+limit>=total} onClick={()=>setOffset(offset+limit)}>다음</button>
+    </div>
+  </div>;
+}
