# ============================================================
# FaxApp 설치 설정 - 고객사 환경에 맞게 수정 후 install.sh 실행
# ============================================================

# --- 설치 경로 ---
INSTALL_ROOT=/opt/faxapp          # 앱·팩스서버 설치 위치
APP_DIR=/opt/faxapp/web           # faxapp 웹 애플리케이션

# --- 네트워크 ---
APP_PORT=8100                     # faxapp 웹 포트
FAXSERVER_PORT=8090               # 팩스서버 대시보드 포트
SERVER_IP=192.168.0.13            # 이 서버의 IP (고정 IP 권장)
GATEWAY_IP=192.168.0.14           # Vega 게이트웨이 IP

# --- 데이터베이스 ---
DB_NAME=faxapp
DB_USER=faxapp
DB_PASS=faxapp                    # 운영 시 반드시 변경!
DB_HOST=127.0.0.1
DB_PORT=5432

# --- FreeSWITCH ---
FS_PREFIX=/usr/local/freeswitch   # FreeSWITCH 설치 위치 (빌드본 배치 경로)
GW_NAME=vega400                   # 게이트웨이 이름

# --- 관리자 초기 계정 (앱 최초 로그인) ---
ADMIN_USER=admin
ADMIN_PASS=admin1234              # 최초 로그인 후 반드시 변경!

# --- 앱 시크릿 (세션 암호화) ---
# 비워두면 install.sh가 랜덤 생성
APP_SECRET=
